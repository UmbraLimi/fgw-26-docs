{
  "permissions": {
    "deny": ["AskUserQuestion"]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-ab-options.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/capture-turn.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "model": "claude-opus-4-8",
  "outputStyle": "default",
  "verbose": false
}
